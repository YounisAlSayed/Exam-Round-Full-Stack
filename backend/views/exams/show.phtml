<?php
require_once __DIR__ . "/../layout.phtml";
// Get data from ViewModel
$exam = $examDetails ?? null;
$attempt = $studentAttempt ?? null;
$selections = $studentSelection ?? [];

// Calculate totals if attempt exists
$totalQuestions = count($selections);
$answeredQuestions = 0;
$correctAnswers = 0;
$totalEarnedMarks = 0;

if (!empty($selections)) {
    // Group selections by question
    $questionsMap = [];
    foreach ($selections as $selection) {
        $qId = $selection['question_id'];
        if (!isset($questionsMap[$qId])) {
            $questionsMap[$qId] = [
                'question_id' => $selection['question_id'],
                'question_text' => $selection['question_text'],
                'question_mark' => $selection['question_mark'],
                'choices' => [],
                'selected_choice_id' => null
            ];
        }
        $questionsMap[$qId]['choices'][] = $selection;
        if ($selection['is_selected']) {
            $questionsMap[$qId]['selected_choice_id'] = $selection['choice_id'];
        }
    }

    $totalQuestions = count($selections);
    $answeredQuestions = 0;
    $correctAnswers = 0;
    $totalEarnedMarks = 0;

    foreach ($questionsMap as $q) {
        if ($q['selected_choice_id'] !== null) {
            $answeredQuestions++;
            // Find if selected choice is correct
            foreach ($q['choices'] as $choice) {
                if ($choice['choice_id'] == $q['selected_choice_id'] && $choice['is_correct']) {
                    $correctAnswers++;
                    $totalEarnedMarks += $q['question_mark'];
                    break;
                }
            }
        }
    }
}

$isSubmitted = $attempt && $attempt['submitted_at'] !== null;
$isActive = false;
$canShowQuestions = false;

if ($exam) {
    $now = new DateTime();
    $startDate = new DateTime($exam['start_date']);
    $endDate = new DateTime($exam['end_date']);

    if ($now >= $startDate && $now <= $endDate) {
        $isActive = true;
    }

    // Show questions only if exam is completed or student has submitted
    if ($now > $endDate || $isSubmitted) {
        $canShowQuestions = true;
    }
}

$percentage = 0;
if ($exam && $exam['total_marks'] > 0) {
    $percentage = round(($totalEarnedMarks / $exam['total_marks']) * 100);
}
?>
