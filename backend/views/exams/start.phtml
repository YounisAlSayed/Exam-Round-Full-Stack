$choices = $choices ?? [];
$currentPage = (int)($page ?? 1);
$pageSize = max(1, (int) ($pageSize ?? 2));
$totalQuestions = count($questions);
$totalPages = max(1, (int) ceil($totalQuestions / $pageSize));

// Calculate time remaining
$timeRemaining = 0;
$timeLimit = 0;
if ($exam) {
    $timeRemaining = max(0, strtotime($exam['end_date']) - time());
    $timeLimit = max(1, strtotime($exam['end_date']) - strtotime($exam['start_date']));
}

// Get saved answers from session for this exam
$savedAnswers = $savedAnswers ?? [];
?>

