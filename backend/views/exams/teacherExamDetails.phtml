$studentsPerformance = $studentPerformance ?? null;

$questionsChoices = $questionsChoices ?? [];

$totalQuestions = count($questions);

$examAttemptStatus = $examAttemptStatus ?? [];

$questionsTotalMarks = 0;
foreach ($questions as $question) {
    $questionsTotalMarks += $question['question_mark'];
}
$percentage = 0;
$scaledScore = 0;
if ($exam && $exam['total_marks'] > 0) {
    $scaledScore = round(($examAttemptStatus['average_mark'] / $questionsTotalMarks) * $exam['total_marks'], 2);
    $percentage = round(($scaledScore / $exam['total_marks']) * 100, 2);
}
