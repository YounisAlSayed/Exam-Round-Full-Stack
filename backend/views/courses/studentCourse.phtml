<?php
require_once __DIR__ . "/../layout.phtml";

$exams = $exams ?? [];
$course = $course ?? null;
$currentUser = $_SESSION['user'] ?? null;

// Get course name from first exam if available
$courseName = $course['name'] ?? (!empty($exams) ? $exams[0]['course_name'] ?? 'Course' : 'Course');

// Calculate statistics
$totalExams = count($exams);
$availableExams = 0;
$completedExams = 0;
$upcomingExams = 0;
$now = new DateTime();

foreach ($exams as $exam) {
    $startDate = new DateTime($exam['start_date']);
    $endDate = new DateTime($exam['end_date']);

    if ($now < $startDate) {
        $upcomingExams++;
    } elseif ($now > $endDate) {
        $completedExams++;
    } else {
        $availableExams++;
    }
}
?>
