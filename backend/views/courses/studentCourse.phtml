                $isUpcoming = $now < $startDate;
                $isActive = $now >= $startDate && $now <= $endDate;
                $isCompleted = $now > $endDate;

                // Calculate time until exam
                if ($isUpcoming) {
                    $diff = $now->diff($startDate);
                    $timeText = $diff->days . ' day' . ($diff->days > 1 ? 's' : '') . ' remaining';
                } elseif ($isActive) {
                    $diff = $now->diff($endDate);
                    $timeText = $diff->h . 'h ' . $diff->i . 'm remaining';
                } else {
                    $timeText = 'Completed';
                }
