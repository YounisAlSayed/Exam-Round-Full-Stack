<script src="<?= BASE_PATH ?>/utils/js/modal.js"></script>
<script>
let allCourses = <?php echo json_encode($courses) ?>;
let userCourses = <?php echo json_encode($userCourses) ?>;
let courses = [...allCourses, ...userCourses];

function courseModal(update = false, course_id = '', course_name = '') {
    const modal = createModal({
        id: 'createCourseModal',
        title: '<i class="fas fa-plus-circle text-primary me-2"></i>Create New Course',
        size: 'md',
        centered: true
    });

    modal.setBody(`
        <form id="createCourseForm" method="POST" action="<?= BASE_PATH ?>/api/courses/${update ? ('update/' + course_id) : 'create'}">
            
            <div class="mb-3">
                <label for="courseName" class="form-label fw-semibold">Course Name <span class="text-danger">*</span></label>
                <input type="text" 
                       class="form-control" 
                       id="courseName" 
                       name="name" 
                       placeholder="e.g., Introduction to Databases"
                       value="${update ? course_name : ''}"
                       required
                       autofocus>
                <div class="invalid-feedback" id="courseNameError">Please enter a course name.</div>
            </div>
        </form>
    `);

    modal.setFooter(`
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i> Cancel
        </button>
        <button form="createCourseForm" type="submit" class="btn btn-primary" id="confirmCreateCourse">
            <i class="fas fa-plus me-1"></i> ${update ? 'Update' : "Create"} Course
        </button>
    `);

    function submit() {

    }
    modal.show();
}

function deleteCourse(courseId, courseName) {
    const confirmDelete = window.confirm(
        `Are you sure you want to delete the course "${courseName}"?\n\n` +
        `This action cannot be undone and will also delete:\n` +
        `• All questions in this course\n` +
        `• All exams associated with this course\n` +
        `• All student enrolments\n` +
        `• All student answers and marks\n\n` +
        `Are you sure?`
    );

    if (confirmDelete) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '<?= BASE_PATH ?>/api/courses/delete/' + courseId;

        const methodInput = document.createElement('input');
        methodInput.type = 'hidden';
        methodInput.name = 'deleted_id';
        methodInput.value = 'DELETE';
        form.appendChild(methodInput);

        document.body.appendChild(form);
        form.submit();
    }
}
</script>