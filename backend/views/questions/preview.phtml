<?php
require_once __DIR__ . "/../layout.phtml";
$course_id = $course_id ?? 0;
$exam_id = $exam_id ?? ($_GET['exam_id'] ?? null);
$question = $question ?? null;
$questionChoices = $questionChoices ?? [];
$isUpdate = !empty($question);
$questionType = $question['question_type'] ?? 'mc';
$showQuestionMark = $isUpdate || !empty($exam_id);

$trueChoice = null;
$falseChoice = null;

if ($questionChoices) {
    foreach ($questionChoices as $c) {
        if (strcasecmp($c['choice_text'], 'True') === 0) {
            $trueChoice = $c;
        } elseif (strcasecmp($c['choice_text'], 'False') === 0) {
            $falseChoice = $c;
        }
    }
}
?>

